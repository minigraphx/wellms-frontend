# Wellms LMS — Environment Variables
# Copy this file to .env.local and fill in your values.

# ─── Wellms Backend ───────────────────────────────────────────────────────────

# Base URL of your Wellms API (no trailing slash)
NEXT_PUBLIC_API_URL=https://your-wellms-backend.com

# ─── OpenRouter (AI features) ─────────────────────────────────────────────────
# Sign up at https://openrouter.ai — free tier available.
# Required for: AI chat widget, "Explain differently" button,
#               quiz gap analysis, lesson summaries, AI project feedback.

OPENROUTER_API_KEY=sk-or-...

# Model to use — any model from https://openrouter.ai/models
# Examples:
#   anthropic/claude-3-haiku        (fast, cheap — default)
#   anthropic/claude-3-5-sonnet     (smarter, more expensive)
#   openai/gpt-4o-mini              (OpenAI alternative)
#   meta-llama/llama-3-8b-instruct  (open-source, very cheap)
OPENROUTER_MODEL=anthropic/claude-3-haiku

# Public URL of this app — sent as HTTP-Referer to OpenRouter
NEXT_PUBLIC_APP_URL=https://your-domain.com
